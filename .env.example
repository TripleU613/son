RUST_LOG=info
LEPTOS_SITE_ADDR=127.0.0.1:3100
# Required for Discord/Twitter link previews to show the image.
SITE_ORIGIN=http://127.0.0.1:3100

# Cloudflare D1. Local dev talks to the same D1 database as production —
# there is no local database at all, deliberately (see README).
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=

# Cloudflare R2 (image storage). Falls back to local disk under ./uploads
# when unset, which is fine for a quick local check but does not reflect how
# uploads behave in production.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# CLIP moderation. Must point at a directory containing pytorch_model.bin and
# tokenizer.json — see README for how to fetch them. Without real weights the
# app fails closed (denies every upload) rather than running unmoderated.
CLIP_MODEL_DIR=models/clip-vit-base-patch32

# Encrypted session cookies (AES-GCM via the cookie crate). Needs >=32 bytes.
# openssl rand -base64 48
SESSION_SECRET=

# Google sign-in. Absent -> "sign in" link redirects with a graceful error
# rather than the app failing to start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
